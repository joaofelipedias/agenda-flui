# Agenda Flui — hospedagem estática (Hostinger / Apache)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Imagens geradas pelo Next sem extensão
<FilesMatch "^(apple-icon|opengraph-image)$">
  ForceType image/png
</FilesMatch>

<IfModule mod_headers.c>
  # Arquivos do Next com hash no nome: cache longo
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # HTML: sempre conferir se há versão nova
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml text/plain application/xml
</IfModule>
