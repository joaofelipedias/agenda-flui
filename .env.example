# Copie para .env.local (desenvolvimento). Na hospedagem estática, os valores entram no momento do build.

# Opcional. URL que também recebe os contatos do formulário via POST (Make, Zapier, n8n, Google Apps Script…).
# Fica visível no código da página. Sem ela, o contato segue só pelo WhatsApp.
NEXT_PUBLIC_LEAD_WEBHOOK_URL=

# Endereço público do site, sem barra no final. Usado em canonical, sitemap, robots, Open Graph e JSON-LD.
NEXT_PUBLIC_SITE_URL=https://agendaflui.com.br
